PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (or set DATABASE_URL instead)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=রসুইঘর
DB_USER=postgres
DB_PASSWORD=change-me

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# ── Email (SMTP) ── leave SMTP_HOST blank in development to print emails to the console
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#         SMTP_USER=you@gmail.com   SMTP_PASS=<16-char App Password from myaccount.google.com/apppasswords>
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="রসুইঘর (Rosuighor) <you@gmail.com>"
